<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rocketchat_server_view_form" model="ir.ui.view">
        <field name="name">rocketchat.server.view.form</field>
        <field name="model">rocketchat.server</field>
        <field name="arch" type="xml">
            <form string="RocketChat Server">
                <header>
                    <button string="Populate" name="action_populate" type="object" class="oe_highlight"/>
                    <button string="Test Channels" name="action_test_channels" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}' />
                        </button>
                    </div>
                    <group>
                        <h1><field name="name" /></h1>
                    </group>
                    <group name="options" string="Options">
                        <field name="server_url" widget="url"/>
                        <field name="login"/>
                        <field name="password" password="True"/>
                        <field name="enable_rocketchat_notification" />
                    </group>
                    <notebook>
                        <page name="channels" string="Channels">
                            <field name="channel_ids" />
                        </page>
                        <page name="users" string="Users">
                            <field name="user_ids">
                                <tree>
                                    <field name="name" />
                                    <field name="username" />
                                    <field name="partner_id" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
