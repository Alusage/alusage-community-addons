<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="top_menu_add_wizard_form_view" model="ir.ui.view">
        <field name="name">top.menu.add.wizard.form</field>
        <field name="model">top.menu.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Add an Existing Menu">
                <group>
                    <field name="parent_id" readonly="1"/>
                    <field name="source_id"/>
                    <field name="mode" widget="radio"/>
                    <field name="include_children"/>
                </group>
                <footer>
                    <button name="action_add_menu" type="object" string="Add" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
