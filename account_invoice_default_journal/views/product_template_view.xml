<odoo>
    <record model="ir.ui.view" id="view_product_template_forced_journal_form">
        <field name="name">product.template.forced_journal.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="property_account_income_id" position="after">
                <field name="forced_journal_id" domain="[('type', '=', 'sale'),'|', ('company_id', '=', False), ('company_id', '=', company_id)]" />
            </field>
            <field name="property_account_expense_id" position="after">
                <field name="forced_purchase_journal_id" domain="[('type', '=', 'purchase'),'|', ('company_id', '=', False), ('company_id', '=', company_id)]" />
            </field>
        </field>
    </record>
</odoo>